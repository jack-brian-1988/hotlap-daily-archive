{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/data.js": {
      "maxDuration": 60
    },
    "api/race.js": {
      "maxDuration": 60
    },
    "api/trueskill.js": {
      "maxDuration": 60
    },
    "api/trueskill-history.js": {
      "maxDuration": 60
    },
    "api/update-dry-run.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/data.json",
      "destination": "/api/data"
    },
    {
      "source": "/trueskill.json",
      "destination": "/api/trueskill"
    }
  ]
}
