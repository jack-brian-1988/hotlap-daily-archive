{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/data.js": {
      "maxDuration": 60
    },
    "api/race.js": {
      "maxDuration": 60
    },
    "api/trueskill.js": {
      "maxDuration": 60
    },
    "api/trueskill-history.js": {
      "maxDuration": 60
    },
    "api/update-dry-run.js": {
      "maxDuration": 120
    },
    "api/update-scheduled.js": {
      "maxDuration": 240,
      "experimentalTriggers": [{ "type": "schedule/v1beta" }]
    }
  },
  "schedules": {
    "hotlap-daily-update": {
      "schedule": "15 0 * * *",
      "timezone": "Etc/UTC",
      "jitter": 15,
      "function": "api/update-scheduled"
    }
  },
  "rewrites": [
    {
      "source": "/data.json",
      "destination": "/api/data"
    },
    {
      "source": "/trueskill.json",
      "destination": "/api/trueskill"
    }
  ]
}
